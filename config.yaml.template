# Mito Location Configuration File
# Configure the parameters for different mitochondrial analysis workflows

# Draw mask: Interactive mask drawing for mitochondrial structures
draw_mask:
  input_directory: '/path/to/input/directory'  # Input directory with TIFF images
  manual_mask_directory: '/path/to/output/directory'  # Output directory for manually drawn masks (optional, defaults to input directory)
  mito_channel: 0  # Channel index for mitochondria (0-based)
  target_channel: 1  # Channel index for target/scan signal (0-based)
  scan_width: 7  # Width of scan lines in pixels
  sampling_radius: 3  # Radius for weighted average sampling in pixels

# Mask refine: Refine mask edges using intensity information
refine_mask:
  input_directory: '/path/to/input/directory'  # Input directory with mask images
  refined_mask_directory: '/path/to/output/directory'  # Output directory for refined masks
  mask_channel: 0  # Channel index for mask (0-based)
  mito_channel: 1  # Channel index for mitochondria (0-based)
  target_channel: 2  # Channel index for target/scan signal (0-based)

# OMM Normal Scan: Scan protein on outer mitochondrial membrane using surface normals
omm_normal_scan:
  input_directory: '/path/to/images/'  # Input directory with TIFF images
  output_directory: '/path/to/output/'  # Output directory
  mito_channel: 1  # Mitochondria channel index (0-based)
  scan_channel: 0  # Scan/protein channel index (0-based)
  mask_channel: 2  # Mask channel index (0-based)
  scan_width: 7  # Width of scan lines in pixels
  sampling_radius: 3  # Radius for weighted average sampling in pixels
  mito_thickness_threshold: 1  # Initial erosion value for mask (1-20)

# Line scan: Scan protein distribution along mitochondrial network
network_line_scan:
  input_dir: '20251021_decon_data/tiff'  # Input directory containing TIFF images
  input_pattern: 'snap*.tiff'  # Pattern to match input TIFF files
  mask_dir_output: '20251021_decon_data/tiff/masks'  # Output directory for masks
  mask_dir_input: '20251021_decon_data/tiff/masks/'  # Input directory for existing masks
  run_name: 'run1'  # Run name suffix for output directories
  mito_channel: 0  # 0-based index for mitochondria channel
  protein_channel: 2  # 0-based index for protein channel
  use_gui: true  # Use interactive GUI for mask selection
  scan_width: 4  # Pixels on each side of the path for scanning
  path_sampling: 5  # Number of subpixel samples along the normal
  min_path_length: 30  # Minimum path length to process
  # --- Ridge-filter mask pipeline (also live-tunable in the GUI) ---
  tubule_radius: 2.0  # Mito tubule radius in px (drives top-hat + ridge sigmas)
  sensitivity: 1.0  # Multiplier on Otsu cut of ridge response (1.0=Otsu)
  min_object_size: 30  # Drop binary connected components smaller than this (px)
  gap_closing: 1  # Binary closing disk radius (px) to bridge small breaks
  # --- Local-thickness filter (applied AFTER skeletonization, requires
  #     the `localthickness` PyPI package) ---
  use_thickness_filter: false  # Filter skeleton by local thickness range
  min_thickness: 1.0  # Min local thickness to keep (px)
  max_thickness: 20.0  # Max local thickness to keep (px)
  # --- Final binary mask export ---
  binary_mask_dir_output: ''  # If set, write the final (thickness-filtered)
                              # mito binary mask as
                              # {basename}_mito_binary.tif (uint8 0/255) into
                              # this directory. Empty = skip saving.

# Analyze OMM scans: Analyze intensity profiles from OMM normal scan results
analyze_omm_scans:
  input_directory: '/path/to/pickle/files/'  # Directory containing pickle files from omm_normal_scan
  output_directory: '/path/to/output/'  # Output directory for plots and CSV (optional, defaults to input directory)
  peak_threshold: 0.3  # Minimum intensity threshold for peaks (0.0-1.0)
  peak_prominence: 0.1  # Minimum prominence threshold for peaks (0.0-1.0)

# Puncta NN scan: detect puncta in the protein channel, classify each as on
# or off the mito binary mask (centroid in mask), and compute nearest-neighbor
# distances within-group (on->on, off->off) and all-to-all (on->any, off->any).
# Outputs per-image puncta CSV + overlay PNG, and pooled CSV + histogram + a
# summary.txt with Mann-Whitney U + KS comparisons.
puncta_nn_scan:
  input_dir: '/path/to/images/'      # Input directory with multi-channel TIFFs
  input_pattern: '*.tif'             # Glob within input_dir
  output_dir: ''                     # Default: same as input_dir
  run_name: 'run1'                   # Suffix on per-image output directories
  mito_channel: 0                    # 0-based mito channel index
  protein_channel: 2                 # 0-based protein/septin channel index
  mtdna_channel: 0                   # 0-based mtDNA channel for the radial
                                     # intensity profile. Defaults to same as
                                     # mito_channel; change to a dedicated
                                     # mtDNA-stain channel (e.g. PicoGreen) if
                                     # you have one.
  # --- Mito binary mask source (dual-purpose). If the file exists we load
  #     and skip mask-making; otherwise we run the SAME mask-making flow as
  #     network_line_scan (lasso ROI -> ridge-filter GUI/no-GUI) and SAVE the
  #     result back into this directory so the next run reuses it. Leave
  #     empty to never load and never save. ---
  mito_binary_dir: ''                # Load/save dir for `{basename}_mito_binary.tif`
  mask_dir_input: ''                 # Pre-saved lasso cell ROIs (optional)
  mask_dir_output: ''                # Where freshly drawn ROIs get saved
  use_gui: true                      # Interactive ridge-filter mask GUI when
                                     # the binary isn't found on disk
  # --- Ridge-filter mask pipeline (mirrors network_line_scan) ---
  tubule_radius: 2.0
  sensitivity: 1.0
  min_object_size: 30
  gap_closing: 1
  use_thickness_filter: false
  min_thickness: 1.0
  max_thickness: 20.0
  # --- Puncta detection (local maxima + threshold) ---
  punct_use_gui: true                # Interactive sliders GUI for puncta
                                     # detection (recomputes peaks live).
                                     # Falls back to headless detect_puncta
                                     # when false.
  punct_blur_sigma: 1.0              # Gaussian smoothing sigma (px); 0 = off
  punct_min_distance: 3              # Min separation (px) between peaks
  punct_threshold_abs: 0.0           # Abs threshold on normalized [0,1] image
  punct_threshold_rel: 0.2           # Relative threshold (fraction of max)
  punct_exclude_border: 1            # Edge pixels to skip
  # --- Radial intensity profile around each punctum ---
  # For every detected punctum, sample mean intensity in concentric integer-
  # distance rings (0..R px) in BOTH the mtDNA and protein/septin channels.
  # Writes a per-image long-format CSV plus pooled CSV + mean ± SEM plot.
  punct_scan_radius: 20              # Profile radius (px) per punctum
  # --- Outputs ---
  save_overlay: true                 # Per-image overlay PNG

# STED colocalization 3D: full 3D mito/mtDNA/septin analysis.
# Builds 3D binary masks (percentile + dilation) for each channel, computes
# Area1 (within K voxels of mtDNA, inside mito) and Area2 (mito, away from
# mtDNA), reports per-area septin intensities and ratios. Additionally, for
# each mtDNA-nucleoid connected component, computes a 3D radial intensity
# profile (spherical shells) in mtDNA / mito / septin channels.
sted_colocalization_3d:
  input_dir: '/path/to/3d/sted/data/'  # 3D multi-channel TIFFs
  input_pattern: '*.tif'               # Glob pattern
  output_dir: ''                       # Default: same as input_dir
  run_name: 'run1'                     # Per-image output dir suffix
  # 3D STED file channel ordering (default: 0=mtDNA, 1=mito, 2=septin)
  mtdna_channel: 0
  mito_channel: 1
  protein_channel: 2
  # 3D mito mask: threshold at Pth percentile of nonzero mito voxels + dilate
  mito_threshold_percentile: 30
  mito_dilation: 3
  # mtDNA mask + Area1 dilation
  mtdna_threshold_percentile: 99
  mtdna_dilation: 3
  # Septin mask threshold (used for stats reporting)
  septin_threshold_percentile: 95
  # 3D radial intensity profile around mtDNA nucleoid centroids
  punct_scan_radius: 20                # Profile radius (voxels, isotropic)
  min_nucleoid_voxels: 5               # Drop tiny mtDNA components
  # Output toggles
  save_channel_mrcs: true              # Per-channel float32 MRC exports
  save_analysis_png: true              # 2x3 central-slice visualization
  save_histogram_png: true             # Per-channel intensity histogram

# Plot peak distance analysis: pool every per-mito CSV from network_line_scan,
# detect peaks on Scan_Intensity (the target/protein channel) with min
# intensity + min prominence, compute the distance between consecutive peaks
# within each track, and histogram all the distances pooled across tracks.
plot_peak_distance_analysis:
  csv_directory: '/path/to/line_scan/output_dir/'  # Where the per-mito CSVs live
  input_pattern: '*_mito_*.csv'                # Glob for the CSV files
  output_directory: ''                         # Default: same as csv_directory
  peak_min_intensity: 0.3                      # Min Scan_Intensity for a peak (0-1)
  peak_min_prominence: 0.1                     # Min prominence (0-1)
  peak_prominence_wlen: 10                     # `wlen` for scipy.peak_prominences
  bin_width: 5.0                               # Histogram bin width (px)
  max_distance: 0.0                            # X-axis cap; 0 = auto (data p99)
  recursive: false                             # Recurse into subdirectories
